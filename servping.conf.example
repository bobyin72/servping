# ============================================================================
# ServPing 配置样例
# ----------------------------------------------------------------------------
# 用法：复制到 /usr/local/etc/servping.conf 后按需修改
#   /bin/cp servping.conf.example /usr/local/etc/servping.conf
#
# 格式：一行一条记录，字段用空格分隔，含空格的内容用双引号包裹
#   Host "<名称>" <地址>         登记一台主机（可多台）
#   Host <地址>                  旧式，名称缺省 = 地址本身
#   ServPort "<名称>" <端口> ["描述"] ["proto"] ["响应体关键字"]
#
# ★两张独立的表
#   Host     = 地址簿，命令的第 1 个位置参数
#   ServPort = 服务表，命令的第 2 个位置参数
#   两表正交：同一套服务名可以套到任意一台 Host 上。
#     例：ServPing local git  → 拿 Git 服务去敲 127.0.0.1:3000
#
# ★ServPort 字段顺序（第 5 位起可省略）
#   1=ServPort 关键字  2=名称  3=端口  4=描述  5=proto  6=响应体关键字
#   proto 取值（第 5 位，缺省 http）
#     http — 校验 HTTP 200；有第 6 字段时再校验响应体是否包含该关键字
#     tcp  — 只判 TCP 三次握手，适用于 SSH / MySQL / Redis 等非 HTTP 服务
#
# ★★唯一原则：一律取第一条
#   1. 缺省 Host = **第一条** Host（不给 Host 时用它）
#   2. 缺省服务 = **第一条** ServPort（不给服务时用它）
#   3. 同名 Host / 同名 ServPort 各自 **只认第一条**（后加的保留但不生效）
#   4. 缺省位写坏了直接报错，绝不让位给后面
#
# ★配置写坏 = 退出码 2，带行号报错（Host 缺地址 / ServPort 缺字段 /
#   端口非数字 / proto 非 http|tcp 都算）。
#
# 说明
#   · 以 # 开头的行是注释，会被忽略
#   · proto=tcp 的服务不校验响应体，写了第 6 字段会被忽略（-a 时会提示）
#   · Host "Foo" 只给一个词时等价于 Host Foo（地址），不是"声明具名主机"
# ============================================================================

# ---- 地址簿（第一条 = 缺省 Host）----
Host "NAS"   192.168.1.10
Host "Local" 127.0.0.1

# ---- 服务表（第一条 = 缺省服务）----
ServPort "Web" 80 "NAS 管理界面" http

# 响应体关键字防「端口通但服务不对」
ServPort "Git" 3000 "Gitea"  http "Gitea"

# 非 HTTP 服务：只测握手
ServPort "SSH" 22   "SSH"    tcp
